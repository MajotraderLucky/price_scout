[Unit]
Description=Daily Price Scout Store Cleanup

[Timer]
# Run daily at 04:00 AM (low activity time)
OnCalendar=*-*-* 04:00:00
# Add random delay up to 1 hour to avoid simultaneous runs
RandomizedDelaySec=3600
# Persistent: run immediately if last run was missed
Persistent=true

[Install]
WantedBy=timers.target
